{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "subject",
              "activity",
              "place",
              "relationship",
              "appearance",
              "creative_change",
              "exclusion"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "source_quote": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "kind",
          "description",
          "priority",
          "source_quote"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 16
    },
    "ambiguities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "reference": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "reference",
          "question"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 8
    },
    "moment_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    }
  },
  "required": [
    "requirements",
    "ambiguities",
    "moment_count"
  ],
  "additionalProperties": false
}
