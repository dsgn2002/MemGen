{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "status": {
      "const": "proposed"
    },
    "user_request": {
      "type": "string",
      "minLength": 1
    },
    "clarification_context": {
      "type": "string"
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "subject",
              "activity",
              "place",
              "relationship",
              "appearance",
              "creative_change",
              "exclusion"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "source_quote": {
            "type": "string",
            "minLength": 1
          },
          "needs_visual_evidence": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "kind",
          "description",
          "priority",
          "source_quote",
          "needs_visual_evidence"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 16
    },
    "ambiguities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "reference": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "reference",
          "question"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 8
    },
    "moment_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "provenance": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "status",
    "user_request",
    "clarification_context",
    "requirements",
    "ambiguities",
    "moment_count",
    "provenance"
  ],
  "additionalProperties": false
}
