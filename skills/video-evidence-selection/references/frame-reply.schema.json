{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "frames": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "frame_id": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "people": {
            "type": "string",
            "minLength": 1
          },
          "people_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 1000
          },
          "setting": {
            "type": "string",
            "minLength": 1
          },
          "view_role": {
            "enum": [
              "overview",
              "group",
              "detail",
              "other"
            ]
          },
          "supported_requirements": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "maxItems": 16
          },
          "uncertain_requirements": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "maxItems": 16
          },
          "visible_details": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "maxItems": 6
          },
          "uncertainties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "maxItems": 32
          }
        },
        "required": [
          "frame_id",
          "summary",
          "people",
          "people_count",
          "setting",
          "view_role",
          "supported_requirements",
          "uncertain_requirements",
          "visible_details",
          "uncertainties"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 12
    }
  },
  "required": [
    "frames"
  ],
  "additionalProperties": false
}
